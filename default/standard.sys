    FUNC bool IsFile (string Path \switch Directory | switch Fifo | switch RegFile | switch Symlink | switch BlockSpecFile | switch CharSpecFile | switch Socket)
        VAR bool ret;
        !python:from run import pyrapid_lib, pyrapid_files
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:kind = ""
        IF Present(Directory) THEN
            !python:kind = "directory"
        ELSEIF Present(Fifo) THEN
            !python:kind = "fifo"
        ELSEIF Present(RegFile) THEN
            !python:kind = "regfile"
        ELSEIF Present(Symlink) THEN
            !python:kind = "symlink"
        ELSEIF Present(BlockSpecFile) THEN
            !python:kind = "blockspecfile"
        ELSEIF Present(CharSpecFile) THEN
            !python:kind = "charspecfile"
        ELSEIF Present(Socket) THEN
            !python:kind = "socket"
        ENDIF
        !python:pyrapid_lib.call(_s("ret").data, lambda path: pyrapid_files.is_file(path, kind), _s("Path").data)
        RETURN ret;
    ENDFUNC

