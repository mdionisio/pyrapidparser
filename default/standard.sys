    !! Motion instructions: run/pyrapid_motion.py, the robot model is selected with
    !! the comment !robot: <model> (run/robotmodel.py). Zones are run as fine points.

    PROC MoveAbsJ(\switch Conc, jointtarget ToJointPos, speeddata Speed \num V | num T, zonedata Zone \num Z, tooldata Tool \wobjdata WObj)
        VAR num mv_v := -1;
        VAR num mv_t := -1;
        VAR num mv_z := -1;
        VAR bool mv_conc := FALSE;
        IF Present(V) THEN
            mv_v := V;
        ENDIF
        IF Present(T) THEN
            mv_t := T;
        ENDIF
        IF Present(Z) THEN
            mv_z := Z;
        ENDIF
        IF Present(Conc) THEN
            mv_conc := TRUE;
        ENDIF
        !python:import pyrapid_motion
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid_motion.MoveAbsJ(_s("mv_conc").data.Get(), _s("ToJointPos").data, _s("Speed").data, _s("mv_v").data.Get(), _s("mv_t").data.Get(), _s("Zone").data, _s("mv_z").data.Get(), _s("Tool").data)
    ENDPROC

    PROC MoveJ(\switch Conc, robtarget ToPoint, speeddata Speed \num V | num T, zonedata Zone \num Z, tooldata Tool \wobjdata WObj)
        VAR num mv_v := -1;
        VAR num mv_t := -1;
        VAR num mv_z := -1;
        VAR bool mv_conc := FALSE;
        VAR wobjdata mv_wobj;
        mv_wobj := wobj0;
        IF Present(V) THEN
            mv_v := V;
        ENDIF
        IF Present(T) THEN
            mv_t := T;
        ENDIF
        IF Present(Z) THEN
            mv_z := Z;
        ENDIF
        IF Present(Conc) THEN
            mv_conc := TRUE;
        ENDIF
        IF Present(WObj) THEN
            mv_wobj := WObj;
        ENDIF
        !python:import pyrapid_motion
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid_motion.MoveJ(_s("mv_conc").data.Get(), _s("ToPoint").data, _s("Speed").data, _s("mv_v").data.Get(), _s("mv_t").data.Get(), _s("Zone").data, _s("mv_z").data.Get(), _s("Tool").data, _s("mv_wobj").data)
    ENDPROC

    PROC MoveL(\switch Conc, robtarget ToPoint, speeddata Speed \num V | num T, zonedata Zone \num Z, tooldata Tool \wobjdata WObj)
        VAR num mv_v := -1;
        VAR num mv_t := -1;
        VAR num mv_z := -1;
        VAR bool mv_conc := FALSE;
        VAR wobjdata mv_wobj;
        mv_wobj := wobj0;
        IF Present(V) THEN
            mv_v := V;
        ENDIF
        IF Present(T) THEN
            mv_t := T;
        ENDIF
        IF Present(Z) THEN
            mv_z := Z;
        ENDIF
        IF Present(Conc) THEN
            mv_conc := TRUE;
        ENDIF
        IF Present(WObj) THEN
            mv_wobj := WObj;
        ENDIF
        !python:import pyrapid_motion
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid_motion.MoveL(_s("mv_conc").data.Get(), _s("ToPoint").data, _s("Speed").data, _s("mv_v").data.Get(), _s("mv_t").data.Get(), _s("Zone").data, _s("mv_z").data.Get(), _s("Tool").data, _s("mv_wobj").data)
    ENDPROC

    PROC SearchL(\switch Stop | switch PStop | switch SStop | switch Sup, VAR signaldi Signal \switch Flanks | switch PosFlank | switch NegFlank | switch HighLevel | switch LowLevel, INOUT robtarget SearchPoint, robtarget ToPoint, speeddata Speed \num V | num T, tooldata Tool \wobjdata WObj)
        ! the signal is read in the time of the robot; the position of the first change is
        ! stored in SearchPoint; \Stop, \PStop and \SStop stop the robot at the change
        VAR num mv_v := -1;
        VAR num mv_t := -1;
        VAR num mv_result := 0;
        VAR wobjdata mv_wobj;
        mv_wobj := wobj0;
        IF Present(V) THEN
            mv_v := V;
        ENDIF
        IF Present(T) THEN
            mv_t := T;
        ENDIF
        IF Present(WObj) THEN
            mv_wobj := WObj;
        ENDIF
        !python:import pyrapid_motion
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_stop = "stop" if pyrapid.Symbols().IsInScope("Stop") else "pstop" if pyrapid.Symbols().IsInScope("PStop") else "sstop" if pyrapid.Symbols().IsInScope("SStop") else ""
        !python:_edge = "both" if pyrapid.Symbols().IsInScope("Flanks") else "neg" if pyrapid.Symbols().IsInScope("NegFlank") or pyrapid.Symbols().IsInScope("LowLevel") else "pos"
        !python:_supervision = not (pyrapid.Symbols().IsInScope("Flanks") or pyrapid.Symbols().IsInScope("PosFlank") or pyrapid.Symbols().IsInScope("NegFlank"))
        !python:_s("mv_result").data.Set(pyrapid_motion.SearchL(_stop, pyrapid.Symbols().IsInScope("Sup"), _s("Signal").data.name, _edge, _supervision, _s("SearchPoint").data, _s("ToPoint").data, _s("Speed").data, _s("mv_v").data.Get(), _s("mv_t").data.Get(), _s("Tool").data, _s("mv_wobj").data))
        IF mv_result = 1 THEN
            RAISE ERR_WHLSEARCH;
        ELSEIF mv_result = 2 THEN
            RAISE ERR_SIGSUPSEARCH;
        ENDIF
    ENDPROC

    PROC MoveC(\switch Conc, robtarget CirPoint, robtarget ToPoint, speeddata Speed \num V | num T, zonedata Zone \num Z, tooldata Tool \wobjdata WObj)
        VAR num mv_v := -1;
        VAR num mv_t := -1;
        VAR num mv_z := -1;
        VAR bool mv_conc := FALSE;
        VAR wobjdata mv_wobj;
        mv_wobj := wobj0;
        IF Present(V) THEN
            mv_v := V;
        ENDIF
        IF Present(T) THEN
            mv_t := T;
        ENDIF
        IF Present(Z) THEN
            mv_z := Z;
        ENDIF
        IF Present(Conc) THEN
            mv_conc := TRUE;
        ENDIF
        IF Present(WObj) THEN
            mv_wobj := WObj;
        ENDIF
        !python:import pyrapid_motion
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid_motion.MoveC(_s("mv_conc").data.Get(), _s("CirPoint").data, _s("ToPoint").data, _s("Speed").data, _s("mv_v").data.Get(), _s("mv_t").data.Get(), _s("Zone").data, _s("mv_z").data.Get(), _s("Tool").data, _s("mv_wobj").data)
    ENDPROC

    RECORD triggdata
        num distance;
        bool atstart;
        bool bytime;
        num lag;
        num delay;
        string signal;
        num value;
    ENDRECORD

    PROC TriggIO(VAR triggdata TriggData, num Distance \switch Start \switch Time, \VAR signaldo DOp | VAR signalgo GOp | VAR signalao AOp | num ProcID, num SetValue \num DODelay)
        ! the output is set when the TCP is Distance mm before the end of the next
        ! movement (\Start: after the start; \Time: seconds before the end)
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_t = _s("TriggData").data
        !python:_t.Set([_s("Distance").data.Get(), pyrapid.Symbols().IsInScope("Start"), pyrapid.Symbols().IsInScope("Time"), 0, _s("DODelay").data.Get() if pyrapid.Symbols().IsInScope("DODelay") else 0, "", _s("SetValue").data.Get()])
        !python:_name = [_s(n).data.name for n in ("DOp", "GOp", "AOp") if pyrapid.Symbols().IsInScope(n)]
        !python:_t.GetElem("signal").Set(_name[0] if _name else "")
    ENDPROC

    PROC TriggInt(VAR triggdata TriggData, num Distance \switch Start \switch Time, VAR intnum Interrupt)
        ! the trap of Interrupt runs when the TCP is Distance mm before the end of the next
        ! movement (\Start: after the start; \Time: seconds before the end)
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_t = _s("TriggData").data
        !python:_t.Set([_s("Distance").data.Get(), pyrapid.Symbols().IsInScope("Start"), pyrapid.Symbols().IsInScope("Time"), 0, 0, "interrupt:%d" % (_s("Interrupt").data.Get(),), 1])
    ENDPROC

    PROC TriggEquip(VAR triggdata TriggData, num Distance \switch Start, num EquipLag \VAR signaldo DOp | VAR signalgo GOp | VAR signalao AOp | num ProcID, num SetValue \switch TriggOn \switch InPos)
        ! like TriggIO, the output is set EquipLag seconds earlier
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_t = _s("TriggData").data
        !python:_t.Set([_s("Distance").data.Get(), pyrapid.Symbols().IsInScope("Start"), False, _s("EquipLag").data.Get(), 0, "", _s("SetValue").data.Get()])
        !python:_name = [_s(n).data.name for n in ("DOp", "GOp", "AOp") if pyrapid.Symbols().IsInScope(n)]
        !python:_t.GetElem("signal").Set(_name[0] if _name else "")
    ENDPROC

