    PROC WaitAI(VAR signalai Signal, \switch LT | switch GT, num Value \num MaxTime \VAR bool TimeFlag)
        VAR bool io_done;
        VAR num io_max := -1;
        VAR bool io_greater := FALSE;
        IF Present(MaxTime) THEN
            io_max := MaxTime;
        ENDIF
        IF Present(GT) THEN
            io_greater := TRUE;
        ENDIF
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_name, _value, _max, _gt = _s("Signal").data.name, _s("Value").data.Get(), _s("io_max").data.Get(), _s("io_greater").data.Get()
        !python:_s("io_done").data.Set(pyrapid.IO.wait(lambda: (pyrapid.IO.get(_name) > _value) if _gt else (pyrapid.IO.get(_name) < _value), None if _max < 0 else _max))
        IF Present(TimeFlag) THEN
            TimeFlag := NOT io_done;
        ELSEIF NOT io_done THEN
            RAISE ERR_WAIT_MAXTIME;
        ENDIF
    ENDPROC

    PROC WaitAO(VAR signalao Signal, \switch LT | switch GT, num Value \num MaxTime \VAR bool TimeFlag)
        VAR bool io_done;
        VAR num io_max := -1;
        VAR bool io_greater := FALSE;
        IF Present(MaxTime) THEN
            io_max := MaxTime;
        ENDIF
        IF Present(GT) THEN
            io_greater := TRUE;
        ENDIF
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_name, _value, _max, _gt = _s("Signal").data.name, _s("Value").data.Get(), _s("io_max").data.Get(), _s("io_greater").data.Get()
        !python:_s("io_done").data.Set(pyrapid.IO.wait(lambda: (pyrapid.IO.get(_name) > _value) if _gt else (pyrapid.IO.get(_name) < _value), None if _max < 0 else _max))
        IF Present(TimeFlag) THEN
            TimeFlag := NOT io_done;
        ELSEIF NOT io_done THEN
            RAISE ERR_WAIT_MAXTIME;
        ENDIF
    ENDPROC

    PROC WaitGO(VAR signalgo Signal, num Value \num MaxTime \VAR bool TimeFlag)
        VAR bool io_done;
        VAR num io_max := -1;
        IF Present(MaxTime) THEN
            io_max := MaxTime;
        ENDIF
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_name, _value, _max = _s("Signal").data.name, _s("Value").data.Get(), _s("io_max").data.Get()
        !python:_s("io_done").data.Set(pyrapid.IO.wait(lambda: pyrapid.IO.get(_name) == _value, None if _max < 0 else _max))
        IF Present(TimeFlag) THEN
            TimeFlag := NOT io_done;
        ELSEIF NOT io_done THEN
