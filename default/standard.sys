    !! Interrupts (run/pyrapid.py, INTERRUPTS): CONNECT links an intnum to a trap routine.

    PROC ISignalDI(\switch Single, VAR signaldi Signal, dionum TriggValue, VAR intnum Interrupt)
        ! the trap runs when the signal changes to TriggValue (2: at any change)
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid.INTERRUPTS.signal(_s("Signal").data.name, None if _s("TriggValue").data.Get() == 2 else _s("TriggValue").data.Get(), _s("Interrupt").data.Get(), pyrapid.Symbols().IsInScope("Single"))
    ENDPROC

    PROC ISignalDO(\switch Single, VAR signaldo Signal, dionum TriggValue, VAR intnum Interrupt)
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid.INTERRUPTS.signal(_s("Signal").data.name, None if _s("TriggValue").data.Get() == 2 else _s("TriggValue").data.Get(), _s("Interrupt").data.Get(), pyrapid.Symbols().IsInScope("Single"))
    ENDPROC

    PROC ISignalGI(\switch Single, VAR signalgi Signal, VAR intnum Interrupt)
        ! the trap runs at any change of the group
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid.INTERRUPTS.signal(_s("Signal").data.name, None, _s("Interrupt").data.Get(), pyrapid.Symbols().IsInScope("Single"))
    ENDPROC

    PROC ISignalGO(\switch Single, VAR signalgo Signal, VAR intnum Interrupt)
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid.INTERRUPTS.signal(_s("Signal").data.name, None, _s("Interrupt").data.Get(), pyrapid.Symbols().IsInScope("Single"))
    ENDPROC

    PROC ITimer(\switch Single, num Time, VAR intnum Interrupt)
        ! the trap runs after Time seconds (every Time seconds without \Single)
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid.INTERRUPTS.timer(_s("Time").data.Get(), _s("Interrupt").data.Get(), pyrapid.Symbols().IsInScope("Single"))
    ENDPROC

    PROC IDelete(VAR intnum Interrupt)
        !python:pyrapid.INTERRUPTS.delete(pyrapid.Symbols().GetSymbol("Interrupt").data.Get())
    ENDPROC

    PROC ISleep(VAR intnum Interrupt)
        !python:pyrapid.INTERRUPTS.sleep(pyrapid.Symbols().GetSymbol("Interrupt").data.Get(), False)
    ENDPROC

    PROC IWatch(VAR intnum Interrupt)
        !python:pyrapid.INTERRUPTS.sleep(pyrapid.Symbols().GetSymbol("Interrupt").data.Get(), True)
    ENDPROC

    PROC IDisable()
        !python:pyrapid.INTERRUPTS.disabled = True
    ENDPROC

    PROC IEnable()
        !python:pyrapid.INTERRUPTS.disabled = False
    ENDPROC

    !! I/O instructions: the signals are in the I/O configuration (--eio of rapid2py),
    !! their values in pyrapid.IO; the simulation of the cell reads and sets them.

    PROC SetDO(\num SDelay | switch Sync, VAR signaldo Signal, dionum Value)
        !python:pyrapid.IO.set(pyrapid.Symbols().GetSymbol("Signal").data.name, int(pyrapid.Symbols().GetSymbol("Value").data.Get()))
    ENDPROC

    PROC Set(VAR signaldo Signal)
        !python:pyrapid.IO.set(pyrapid.Symbols().GetSymbol("Signal").data.name, 1)
    ENDPROC

    PROC Reset(VAR signaldo Signal)
        !python:pyrapid.IO.set(pyrapid.Symbols().GetSymbol("Signal").data.name, 0)
    ENDPROC

    PROC PulseDO(\switch High, \num PLength, VAR signaldo Signal)
        VAR num io_length := 0.2;
        IF Present(PLength) THEN
            io_length := PLength;
        ENDIF
        !python:pyrapid.IO.pulse(pyrapid.Symbols().GetSymbol("Signal").data.name, pyrapid.Symbols().GetSymbol("io_length").data.Get())
    ENDPROC

    PROC SetGO(VAR signalgo Signal, num Value)
        !python:pyrapid.IO.set(pyrapid.Symbols().GetSymbol("Signal").data.name, pyrapid.Symbols().GetSymbol("Value").data.Get())
    ENDPROC

    PROC SetAO(VAR signalao Signal, num Value)
        !python:pyrapid.IO.set(pyrapid.Symbols().GetSymbol("Signal").data.name, pyrapid.Symbols().GetSymbol("Value").data.Get())
    ENDPROC

    PROC WaitDI(VAR signaldi Signal, dionum Value \num MaxTime \VAR bool TimeFlag)
        VAR bool io_done;
        VAR num io_max := -1;
        IF Present(MaxTime) THEN
            io_max := MaxTime;
        ENDIF
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_name, _value, _max = _s("Signal").data.name, _s("Value").data.Get(), _s("io_max").data.Get()
        !python:_s("io_done").data.Set(pyrapid.IO.wait(lambda: pyrapid.IO.get(_name) == _value, None if _max < 0 else _max))
        IF Present(TimeFlag) THEN
            TimeFlag := NOT io_done;
        ELSEIF NOT io_done THEN
            RAISE ERR_WAIT_MAXTIME;
        ENDIF
    ENDPROC

    PROC WaitDO(VAR signaldo Signal, dionum Value \num MaxTime \VAR bool TimeFlag)
        VAR bool io_done;
        VAR num io_max := -1;
        IF Present(MaxTime) THEN
            io_max := MaxTime;
        ENDIF
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:_name, _value, _max = _s("Signal").data.name, _s("Value").data.Get(), _s("io_max").data.Get()
        !python:_s("io_done").data.Set(pyrapid.IO.wait(lambda: pyrapid.IO.get(_name) == _value, None if _max < 0 else _max))
        IF Present(TimeFlag) THEN
            TimeFlag := NOT io_done;
        ELSEIF NOT io_done THEN
            RAISE ERR_WAIT_MAXTIME;
        ENDIF
    ENDPROC

    PROC WaitGI(VAR signalgi Signal, num Value \num MaxTime \VAR bool TimeFlag)
        VAR bool io_done;
        VAR num io_max := -1;
