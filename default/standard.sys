    !! Files and directories (run/pyrapid_files.py): the paths "HOME:/dir/file" are
    !! relative to PYRAPID_HOME (default: the current folder), "TEMP:" to the temporary
    !! folder; the serial channels are not supported.

    CONST num EOF_BIN := -1;
    CONST num EOF_NUM := 9.998E36;

    PROC Open (string Object, VAR iodev IODevice \switch File \switch Read | switch Write | switch Append \switch Bin)
        !python:from run import pyrapid_lib, pyrapid_files
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:mode = "write"
        IF Present(Read) THEN
            !python:mode = "read"
        ELSEIF Present(Append) THEN
            !python:mode = "append"
        ENDIF
        !python:binary = pyrapid.Symbols().IsInScope("Bin")
        !python:pyrapid_lib.call(_s("IODevice").data, lambda path: pyrapid_files.open_file(path, mode, binary), _s("Object").data)
    ENDPROC

    PROC Close (VAR iodev IODevice)
        !python:from run import pyrapid_lib, pyrapid_files
        !python:pyrapid_lib.call(None, pyrapid_files.close, pyrapid.Symbols().GetSymbol("IODevice").data)
    ENDPROC

    PROC Rewind (VAR iodev IODevice)
        !python:from run import pyrapid_lib, pyrapid_files
        !python:pyrapid_lib.call(None, pyrapid_files.rewind, pyrapid.Symbols().GetSymbol("IODevice").data)
    ENDPROC

    PROC ClearIOBuff (VAR iodev IODevice)
        !python:from run import pyrapid_lib, pyrapid_files
        !python:pyrapid_lib.call(None, pyrapid_files.clear_buffer, pyrapid.Symbols().GetSymbol("IODevice").data)
    ENDPROC

    PROC Write (VAR iodev IODevice, string String \num Num | bool Bool | pos Pos | orient Orient | dnum Dnum \switch NoNewLine)
        ! the string and the value as TPWrite does
        !python:from run import pyrapid_lib, pyrapid_files
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:val = _s("String").data.Get()
        IF Present(Num) THEN
            !python:val = val + pyrapid.rapid_text(_s("Num").data)
        ELSEIF Present(Bool) THEN
            !python:val = val + pyrapid.rapid_text(_s("Bool").data)
        ELSEIF Present(Pos) THEN
            !python:val = val + pyrapid.rapid_text(_s("Pos").data)
        ELSEIF Present(Orient) THEN
            !python:val = val + pyrapid.rapid_text(_s("Orient").data)
        ELSEIF Present(Dnum) THEN
            !python:val = val + pyrapid.rapid_text(_s("Dnum").data)
        ENDIF
        !python:newline = not pyrapid.Symbols().IsInScope("NoNewLine")
        !python:pyrapid_lib.call(None, lambda device: pyrapid_files.write(device, val, newline), _s("IODevice").data)
    ENDPROC

    PROC WriteBin (VAR iodev IODevice, num Buffer{*}, num NChar)
        !python:from run import pyrapid_lib, pyrapid_files
        !python:_s = pyrapid.Symbols().GetSymbol
