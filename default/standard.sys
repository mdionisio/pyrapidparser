    FUNC robtarget RelTool(robtarget Point, num Dx, num Dy, num Dz \num Rx \num Ry \num Rz)
        VAR robtarget ret;
        VAR num mv_rx := 0;
        VAR num mv_ry := 0;
        VAR num mv_rz := 0;
        IF Present(Rx) THEN
            mv_rx := Rx;
        ENDIF
        IF Present(Ry) THEN
            mv_ry := Ry;
        ENDIF
        IF Present(Rz) THEN
            mv_rz := Rz;
        ENDIF
        !python:import pyrapid_motion
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:pyrapid_motion.RelTool(_s("ret").data, _s("Point").data, _s("Dx").data.Get(), _s("Dy").data.Get(), _s("Dz").data.Get(), _s("mv_rx").data.Get(), _s("mv_ry").data.Get(), _s("mv_rz").data.Get())
        RETURN ret;
    ENDFUNC

