    FUNC bool ReadDir (VAR dir Dev, VAR string FileName)
        ! FALSE at the end of the directory
        VAR bool ret;
        !python:from run import pyrapid_lib, pyrapid_files
        !python:_s = pyrapid.Symbols().GetSymbol
        !python:entry = []
        !python:pyrapid_lib.call(None, lambda device: entry.append(pyrapid_files.read_dir(device)), _s("Dev").data)
        !python:_s("ret").data.Set(entry[0] is not None)
        IF ret THEN
            !python:_s("FileName").data.Set(entry[0])
        ENDIF
        RETURN ret;
    ENDFUNC

    PROC CloseDir (VAR dir Dev)
        !python:from run import pyrapid_lib, pyrapid_files
