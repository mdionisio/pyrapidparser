<?xml version="1.0"?>
<!--
  ABB IRB 460-110/2.4, 4 axis palletizer: APPROXIMATE kinematic model.

  ABB does not publish the link lengths and no URDF of this robot exists. The
  lengths are estimated so that the model matches the ABB data sheet
  (IRB 460, ROB0206EN_A, 2011): reach 2403 mm (axis 2 at +85 deg, axis 3 at 0),
  top of the working range 1786 mm (axis 2 at 0, axis 3 at -20 deg).
  The geometry is made of boxes and cylinders; there is no inertial data.

  The parallel linkage keeps the flange horizontal: axis 3 is the angle of the
  upper arm from the horizontal, so joint_3 = axis 3 - axis 2 and the passive
  joint_4 = -axis 3 (see irb460_approx.json).
-->
<robot name="irb460_approx">
  <material name="robot_grey">
    <color rgba="0.85 0.85 0.85 1"/>
  </material>
  <material name="robot_dark">
    <color rgba="0.25 0.25 0.25 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="1.007 0.720 0.2"/></geometry>
      <material name="robot_dark"/>
    </visual>
  </link>
  <link name="base"/>
  <joint name="base_link-base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry><cylinder radius="0.32" length="0.5"/></geometry>
      <material name="robot_grey"/>
    </visual>
    <visual>
      <origin xyz="0.13 0 0.7425" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.2" length="0.5"/></geometry>
      <material name="robot_grey"/>
    </visual>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8798" upper="2.8798" velocity="2.5307" effort="0"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.4725" rpy="0 0 0"/>
      <geometry><box size="0.2 0.25 1.045"/></geometry>
      <material name="robot_grey"/>
    </visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.26 0 0.7425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" velocity="1.9199" effort="0"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0.44 0 0" rpy="0 0 0"/>
      <geometry><box size="1.18 0.2 0.18"/></geometry>
      <material name="robot_grey"/>
    </visual>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.945" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" velocity="2.0944" effort="0"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="0.11 0 -0.09" rpy="0 0 0"/>
      <geometry><box size="0.3 0.2 0.3"/></geometry>
      <material name="robot_grey"/>
    </visual>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.98 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" velocity="2.0944" effort="0"/>
  </joint>

  <link name="link_6">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.04"/></geometry>
      <material name="robot_dark"/>
    </visual>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_4"/>
    <child link="link_6"/>
    <origin xyz="0.22 0 -0.24" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-5.2360" upper="5.2360" velocity="6.9813" effort="0"/>
  </joint>

  <!-- ABB tool0: z out of the flange, pointing down -->
  <link name="tool0"/>
  <joint name="joint_6-tool0" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 3.14159265358979 0"/>
  </joint>
</robot>
